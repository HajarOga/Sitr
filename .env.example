# SafeShare2 - configuration template.
#
# Copy this file to .env and fill in your own key:
#     cp .env.example .env
#
# app/config.py reads .env at import time; a real environment variable always wins over
# it. .env itself is in .gitignore and must never be committed.

# Which model answers: api | local | auto
#   api   - an OpenAI-compatible endpoint; the document text is part of the prompt
#   local - Qwen runs in this process; nothing leaves the machine
#   auto  - api when a key is set below, local otherwise
SAFESHARE2_PROVIDER=api

# Used when the provider is api (or auto with a key).
SAFESHARE2_API_BASE_URL=https://api.deepseek.com
SAFESHARE2_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Used when the provider is local. Install the weights with:
#     python -m scripts.setup_model
# SAFESHARE2_MODEL=Qwen/Qwen2.5-3B-Instruct
